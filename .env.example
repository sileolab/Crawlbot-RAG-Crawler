# Crawlbot Configuration
# Copy this file to .env and adjust values as needed.

# Application
CRAWLBOT_APP_ENV=development
CRAWLBOT_HOST=127.0.0.1
CRAWLBOT_PORT=8000

# Crawling defaults
CRAWLBOT_MAX_CRAWL_DEPTH=3
CRAWLBOT_MAX_PAGES=500
CRAWLBOT_REQUEST_TIMEOUT=30.0
CRAWLBOT_MAX_CONCURRENCY=5
CRAWLBOT_DELAY_BETWEEN_REQUESTS=1.0
CRAWLBOT_MAX_RESPONSE_SIZE=10485760

# Extraction
CRAWLBOT_DEFAULT_EXTRACTION_STRATEGY=trafilatura

# Output
CRAWLBOT_OUTPUT_DIR=output
CRAWLBOT_LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI / AI Features (optional)
# Paste your API key below to enable Chunking + Embedding + RAG Enhancement.
# Leave blank to skip AI features — all other crawling/extraction still works.
#
# If using an alternative OpenAI-compatible provider (e.g. OpenRouter, DeepSeek,
# Groq, Together, Ollama, AvalAI, etc.), provide their base URL below.
# Example: https://openrouter.ai/api/v1  OR  https://api.deepseek.com/v1
# Default if left blank: https://api.openai.com/v1
# ─────────────────────────────────────────────────────────────────────────────
CRAWLBOT_OPENAI_API_KEY=
CRAWLBOT_OPENAI_BASE_URL=
CRAWLBOT_EMBEDDING_MODEL=text-embedding-3-small
CRAWLBOT_LLM_MODEL=gpt-4o-mini
CRAWLBOT_AI_CONCURRENCY=3
